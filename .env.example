# --- database ---
# avoid % and @ characters in the password (they break URL parsing)
# use 127.0.0.1 (not localhost): on Windows "localhost" can resolve to IPv6 ::1
# first, where the IPv4-only compose port binding does not listen -> slow connects
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql+psycopg://agent:change-me-strong@127.0.0.1:5432/agent

# --- auth ---
JWT_SECRET=generate: python -c "import secrets; print(secrets.token_hex(32))"

# --- llm providers ---
# Each provider is used through its OWN native SDK (app/core/providers/), so nothing is
# degraded by a compatibility layer. These are the DEFAULTS; a user can pick their
# provider and models in the app's Settings screen (stored per user).
LLM_PROVIDER=google          # google | openai
MODEL_CHAT=gemini-3.5-flash
MODEL_HEAVY=gemini-3.1-pro-preview

# Google = Agent Platform (Vertex). Billed through Google Cloud Billing, so Cloud
# credits apply. Auth is Application Default Credentials — NO api key:
#   local: gcloud auth application-default login
#   prod:  the GCE VM's own service account (needs roles/aiplatform.user) — nothing here
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# OpenAI (optional): the one provider that still needs a key. Leave blank and OpenAI
# simply isn't offered in Settings. Keys live here only — never in the UI.
OPENAI_API_KEY=
# OPENAI_BASE_URL=           # optional: proxy / compatible host

# Legacy Gemini Developer API (prepaid key) — kept only as a fallback path.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# thinking budget: chat is fast (low); "deep" is used when you hit "think harder"
# in the web UI, or when a heavy task routes to it.
# Empty = don't send the param. (Gemini 3 can be turned down to "low", not off.)
REASONING_EFFORT_CHAT=low
REASONING_EFFORT_DEEP=high

# Max tool-use rounds the assistant may take in one chat turn before it must
# answer with text (guards against a runaway tool loop).
# TOOLS_MAX_ITERS=5
# How many open tasks are shown to the model each turn, so it can avoid creating
# duplicates, act by id in one step, and surface what's due.
# CONTEXT_TASKS_LIMIT=30
# Retry transient provider errors this many times — only before the first token,
# so streamed output is never duplicated.
# LLM_MAX_RETRIES=2
# Reject a user message longer than this (characters) before persisting or calling.
# MAX_INPUT_CHARS=16000

# --- memory (pgvector) ---
# facts about you are embedded and recalled by semantic search.
# PINNED ON PURPOSE: every stored vector came from this model, and vectors from a
# different model are not comparable (same length, different meaning) — recall would
# silently return nonsense. Changing chat provider does NOT change these. Changing them
# means re-embedding every stored fact in one deliberate migration.
# EMBED_DIM must match the profile_facts.embedding column (migration 002 = 768).
EMBED_PROVIDER=google
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Ceiling on facts recalled per message. Commented out so the CODE default applies —
# pinning it here is what quietly kept a machine on 12 after the default moved to 16,
# and a template that overrides a default is a default nobody can change.
# MEMORY_RECALL_K=16
# Cosine distance below which a newly extracted fact is suspected of already being known.
# It is NOT a delete threshold: a fact this close is stored and flagged, never dropped.
# MEMORY_DEDUP_DISTANCE=0.12
# MODEL_MEMORY=            # extractor model; empty = use MODEL_CHAT
# MEMORY_EXTRACTION_ENABLED=true

# --- app ---
APP_TIMEZONE=Asia/Kolkata
# dev: the Vite dev server. prod: your Vercel URL, e.g. https://aceroai.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# --- trace retention (see docs/DEPLOY.md) ---
# How long the observability tables keep detail before the daily rollup takes over.
# The rollup itself is kept forever, so shortening these never changes a spend figure —
# it only shortens how far back the waterfall and the latency percentiles reach.
# SPAN_RETENTION_DAYS=30
# TURN_RETENTION_DAYS=400

# --- notifications (web push) ---
# One key pair identifying this server to the browsers' push services. Generate ONCE:
#     cd backend && uv run python -m app.scripts.generate_vapid
# Leave these blank and notifications are still RECORDED and readable in the app; only
# delivery to a device is unavailable.
#
# WARNING: replacing this pair silently invalidates every device that has already
# subscribed. They keep their permission and quietly stop receiving anything.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push service can use to reach you about a misbehaving sender. Required.
VAPID_SUBJECT=mailto:you@example.com

# The frontend needs the public half too, and FETCHES it from
# GET /api/notifications/push - it is public by design. There is deliberately no build-time
# copy of it: one source of truth, and rotating the pair does not need a frontend rebuild.

# --- scheduled jobs ---
# How often the scheduler asks "is anything due". NOT how often jobs run - each job's own
# schedule decides that. This only bounds how late a due job starts.
# JOB_TICK_SECONDS=300
# Quiet hours, as local hours. A notification raised inside the window is still WRITTEN;
# only the push is suppressed, so it is waiting in the app in the morning.
# QUIET_HOURS_START=22
# QUIET_HOURS_END=7
# DAILY_PUSH_CAP=6
# NOTIFICATION_RETENTION_DAYS=90

# --- production (only set these on the server; see docs/DEPLOY.md) ---
# APP_ENV=prod                 # refuses to start if JWT_SECRET is the dev default
# COOKIE_SECURE=true           # required (HTTPS) so the browser stores the cookie
# COOKIE_SAMESITE=none         # required for the cross-site Vercel -> backend cookie
# SOUL_PATH=/docs/SOUL.md      # the prod compose mounts docs/ here
# SITE_ADDRESS=acero.duckdns.org   # your DuckDNS host (Caddy uses it for auto-TLS)
# In prod, DATABASE_URL uses the compose service host "db":
#   DATABASE_URL=postgresql+psycopg://agent:${POSTGRES_PASSWORD}@db:5432/agent

# Embeddings are served from a REGION, not "global": measured, the global endpoint takes
# ~12s per embedding once the connection goes cold (i.e. every real message) while
# us-central1 takes ~0.5-2s. Vectors are identical across regions (verified cosine
# 1.000000), so this is a pure latency fix. See docs/REQUEST-ANATOMY.md.
EMBED_LOCATION=us-central1
# Hard ceiling on memory recall; past this we answer without facts rather than stall.
MEMORY_RECALL_TIMEOUT_S=4.0
